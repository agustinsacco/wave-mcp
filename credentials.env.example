# Copy to ~/.config/wave-mcp/credentials.env and chmod 600. Never commit it.
# Simplest: run "node bin/wave-mcp.js login" and paste a request copied from the
# Wave web app; it fills in the right key below for you.

# Web session (written by "wave-mcp login"; live transaction tools need it; expires on sign-out)
# WAVE_SESSION_TOKEN=

# Option A: full access token (developer portal -> Manage applications -> Full access tokens)
WAVE_ACCESS_TOKEN=

# Option B: OAuth 2 (then run: node bin/wave-mcp.js auth). Tokens are written back here.
# WAVE_CLIENT_ID=
# WAVE_CLIENT_SECRET=
# WAVE_REDIRECT_URI=http://localhost:8765/callback

# Optional: default business (see: node bin/wave-mcp.js check)
# WAVE_BUSINESS_ID=

# Optional: bearer token for the HTTP transport (openssl rand -hex 32)
# WAVE_MCP_HTTP_TOKEN=
